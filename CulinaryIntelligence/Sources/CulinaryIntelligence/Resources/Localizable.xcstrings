    "Edit.Prompt.Placement.Change": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Which step does this change belong in? Give the number of the step."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
