    "Edit.Prompt.Placement.Ask": {
      "extractionState": "manual",
      "localizations": {
        "en-US": {
          "stringUnit": {
            "state": "translated",
            "value": "Which step should use %1$@? Give the number of the step it is added in."
          }
        },
        "ja": {
