    "Onboarding.Consent.Description" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plates writes recipes with two models that run outside your iPhone. Allow Plates to send them what they need."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platesは、iPhoneの外で動く2つのモデルを使ってレシピを書きます。必要な情報をこれらのモデルに送ることを許可してください。"
          }
        }
      }
    },
    "Onboarding.Consent.Footer" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "If you do not allow this, you can still write recipes yourself, add the samples, and cook from them. You can change this later under AI Processing in the menu."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "許可しなくても、自分でレシピを書いたり、サンプルを追加して調理したりできます。あとからメニューの「外部処理」で変更できます。"
          }
        }
      }
    },
