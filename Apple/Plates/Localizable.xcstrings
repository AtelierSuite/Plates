    "AIProcessing.Footer.Off" : {
      "extractionState" : "manual",
      "localizations" : {
        "en-US" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Recipes are written by hand, and nothing is sent to Gemma or Jev."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レシピは自分で書きます。GemmaやJevには何も送られません。"
          }
