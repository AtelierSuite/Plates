  "troubleshooting": [
    {
      "problem": "中が生の卵液のままだった",
      "solution": "ふたをせずに焼いたか、火が強くて中まで火が通る前に表面が色づきました。ここはふたが仕事をします。弱火で5分しっかり取ってください。"
    },
    {
      "problem": "外側が焦げた",
      "solution": "砂糖の多い生地に火が強すぎます。最後まで弱火にし、パンを入れる前にバターが茶色くなったら、拭き取ってやり直します。"
    },
    {
      "problem": "浸しているあいだにパンが崩れた",
      "solution": "焼きたての柔らかいパンには支えがありません。一晩出して乾かすか、低温のオーブンで10分乾かしてから浸します。"
    },
    {
      "problem": "中がぱさついた",
      "solution": "厚みに対して浸し時間が足りません。3cmなら30分、できれば冷蔵庫で一晩です。卵液はふちだけでなく中心まで届かせます。"
    },
    {
      "problem": "白い筋が残った",
      "solution": "卵が混ざりきっておらず、卵液をこしていません。どちらも1分で済み、どちらも焼き上がりに出ます。"
    },
    {
      "problem": "浸す時間がない",
      "solution": "牛乳を人肌に温めてから混ぜます。温かい卵液なら片面10分ほどで中まで入ります。"
    },
    {
      "problem": "もっとこくがほしい",
      "solution": "牛乳大さじ2を生クリームに替えるか、卵黄を1個足します。こくのために砂糖を増やすと、甘くなる前に焦げます。"
    }
  ]
