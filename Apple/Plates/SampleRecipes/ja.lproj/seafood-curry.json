  "troubleshooting": [
    {
      "problem": "水っぽく仕上がった",
      "solution": "シーフードから水が出たか、ルーを入れたあと温め直していません。解凍して水気をしっかり取り、最後に弱火で5分かけます。"
    },
    {
      "problem": "固すぎる",
      "solution": "ルーに対して水が少ないか、ふたを開けたまま煮詰めすぎました。湯を少しずつ足してのばします。冷めるとまた固くなります。"
    },
    {
      "problem": "ルーが溶けない",
      "solution": "煮立った中に入れています。火を止め、泡が消えてから小さく割って入れます。できてしまったかたまりは、お玉で鍋肌に押し付けて潰します。"
    },
    {
      "problem": "いかがゴムのようになった",
      "solution": "火を通しすぎです。シーフードは最後の数分だけ鍋に入れ、入れたあとは煮立てません。"
    },
    {
      "problem": "味がぼやける",
      "solution": "玉ねぎの炒めが足りません。10分が最低線です。できあがったカレーには、しょうゆ小さじ1とはちみつ小さじ1で厚みが出ます。"
    },
    {
      "problem": "とがった味がする",
      "solution": "火を止めてから牛乳を大さじ2入れると和らぎます。バターを少し落としても同じです。どちらも入れたあとは煮立てません。"
    },
    {
      "problem": "フライパンが空いていない",
      "solution": "ルーを溶かしたあとの鍋に、水気を取ったシーフードをそのまま入れて弱火で2分煮ます。焼き目は出ませんが、食感は保てます。"
    }
  ]
