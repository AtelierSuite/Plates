  "troubleshooting": [
    {
      "problem": "べちゃっとした",
      "solution": "炊きたてのごはんに汁を入れたか、汁を一度に入れています。前日のごはんを使い、汁は30秒煮詰めてからごはんを入れます。"
    },
    {
      "problem": "とがった生の味がする",
      "solution": "キムチの炒めが足りません。中火で4分炒めると酸味が甘みに変わります。香りが変わるところが合図です。"
    },
    {
      "problem": "酸っぱすぎる",
      "solution": "発酵が進んだキムチです。砂糖を小さじ1足すか、バターを少し落とします。どちらも甘くせずに角を取ります。"
    },
    {
      "problem": "ごはんがかたまる",
      "solution": "冷たいままほぐさずに入れています。濡らした手でほぐし、混ぜるのではなく押し付けるように炒めます。"
    },
    {
      "problem": "味がぼやける",
      "solution": "浅いキムチか、量が足りません。ごはん350gにキムチ200gです。コチュジャンは色とこくを足すもので、酸味は足しません。"
    },
    {
      "problem": "豚バラ肉がない",
      "solution": "ベーコンなら油を足さずに使えます。ツナ缶は汁気を切り、最初ではなくごはんと一緒に入れます。どちらもないときは、仕上げのごま油を小さじ1増やします。"
    },
    {
      "problem": "コチュジャンがない",
      "solution": "入れずに、しょうゆを小さじ1足します。辛みはキムチが持っています。色が落ち、辛さも少し控えめになります。"
    }
  ]
